# ---- Live AI (server-side only; never prefix with NEXT_PUBLIC_) ----\n# Google Gemini (free tier available; check current limits)\n# GEMINI_API_KEY=\nGEMINI_MODEL=gemini-3.8-flash\n# AI_PROVIDER=gemini
# Option A: Claude (Anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=            # optional proxy/gateway
#
# Option B: OpenAI or any OpenAI-compatible provider
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # base /v1 URL or full /chat/completions URL
#
# Set AI_PROVIDER=gemini, anthropic, or openai to choose explicitly.


# Optional: add these only when you configure real services.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: AI request timeout in milliseconds (default 55000)
AI_TIMEOUT_MS=55000
